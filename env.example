import { useState, useEffect, useMemo } from 'react';
import { Expense, DashboardStats, ExpenseFilterState, FunctionalCategory, TimeChartPoint } from '../types';
import { generateSampleExpenses } from '../utils/sampleData';
import { db, collection, doc, setDoc, deleteDoc, onSnapshot, query, orderBy } from '../lib/firebase';
import { User } from 'firebase/auth';

const STORAGE_KEY = 'pet_pwa_expenses';

export function useExpenses(user: User | null) {
  const [expenses, setExpenses] = useState<Expense[]>(() => {
    const local = localStorage.getItem(STORAGE_KEY);
    if (local) {
      try {
        const parsed = JSON.parse(local);
        if (Array.isArray(parsed) && parsed.length > 0) return parsed;
      } catch (e) {
        console.error('Failed to parse local expenses:', e);
      }
    }
    const initial = generateSampleExpenses(user ? user.uid : 'local_guest');
    localStorage.setItem(STORAGE_KEY, JSON.stringify(initial));
    return initial;
  });

  const [loading, setLoading] = useState<boolean>(false);
  const [syncStatus, setSyncStatus] = useState<'synced' | 'local' | 'syncing' | 'error'>('local');

  // Real-time Firestore sync when user is authenticated
  useEffect(() => {
    if (!user) {
      setSyncStatus('local');
      return;
    }

    setSyncStatus('syncing');
    setLoading(true);

    const expensesRef = collection(db, 'users', user.uid, 'expenses');
    const q = query(expensesRef, orderBy('date', 'desc'));

    const unsubscribe = onSnapshot(
      q,
      (snapshot) => {
        const firestoreExpenses: Expense[] = [];
        snapshot.forEach((docSnap) => {
          const data = docSnap.data();
          firestoreExpenses.push({
            id: docSnap.id,
            userId: user.uid,
            title: data.title || 'Expense',
            amount: Number(data.amount) || 0,
            date: data.date || new Date().toISOString().slice(0, 10),
            financialCategory: data.financialCategory || 'Miscellaneous',
            functionalCategory: data.functionalCategory || 'Miscellaneous',
            paymentMethod: data.paymentMethod || 'Cash',
            note: data.note || '',
            createdAt: data.createdAt || Date.now(),
          });
        });

        // If user has zero expenses in Firestore, sync existing local items up to Firestore
        if (firestoreExpenses.length === 0 && expenses.length > 0) {
          syncLocalToFirestore(user.uid, expenses);
        } else {
          setExpenses(firestoreExpenses);
          localStorage.setItem(STORAGE_KEY, JSON.stringify(firestoreExpenses));
        }

        setSyncStatus('synced');
        setLoading(false);
      },
      (err) => {
        console.warn('Firestore Expenses snapshot error, falling back to local state:', err);
        setSyncStatus('error');
        setLoading(false);
      }
    );

    return () => unsubscribe();
  }, [user?.uid]);

  // Sync local data to Firestore when user signs in for the first time
  const syncLocalToFirestore = async (userId: string, items: Expense[]) => {
    try {
      for (const item of items) {
        const docRef = doc(db, 'users', userId, 'expenses', item.id);
        await setDoc(docRef, {
          userId,
          title: item.title,
          amount: item.amount,
          date: item.date,
          financialCategory: item.financialCategory,
          functionalCategory: item.functionalCategory,
          paymentMethod: item.paymentMethod,
          note: item.note || '',
          createdAt: item.createdAt || Date.now(),
        });
      }
    } catch (e) {
      console.error('Failed to batch sync local expenses to Firestore:', e);
    }
  };

  // Add Expense
  const addExpense = async (expenseData: Omit<Expense, 'id' | 'createdAt'>) => {
    const id = `exp_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`;
    const newExpense: Expense = {
      ...expenseData,
      id,
      userId: user ? user.uid : 'local_guest',
      createdAt: Date.now(),
    };

    // Optimistic UI update
    setExpenses((prev) => {
      const updated = [newExpense, ...prev];
      localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
      return updated;
    });

    if (user) {
      try {
        const docRef = doc(db, 'users', user.uid, 'expenses', id);
        await setDoc(docRef, {
          userId: user.uid,
          title: newExpense.title,
          amount: newExpense.amount,
          date: newExpense.date,
          financialCategory: newExpense.financialCategory,
          functionalCategory: newExpense.functionalCategory,
          paymentMethod: newExpense.paymentMethod,
          note: newExpense.note || '',
          createdAt: newExpense.createdAt,
        });
      } catch (err) {
        console.error('Failed to save expense to Firestore:', err);
      }
    }
  };

  // Update Expense
  const updateExpense = async (updatedItem: Expense) => {
    setExpenses((prev) => {
      const updated = prev.map((item) => (item.id === updatedItem.id ? updatedItem : item));
      localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
      return updated;
    });

    if (user) {
      try {
        const docRef = doc(db, 'users', user.uid, 'expenses', updatedItem.id);
        await setDoc(docRef, {
          userId: user.uid,
          title: updatedItem.title,
          amount: updatedItem.amount,
          date: updatedItem.date,
          financialCategory: updatedItem.financialCategory,
          functionalCategory: updatedItem.functionalCategory,
          paymentMethod: updatedItem.paymentMethod,
          note: updatedItem.note || '',
          createdAt: updatedItem.createdAt || Date.now(),
          updatedAt: Date.now(),
        });
      } catch (err) {
        console.error('Failed to update expense in Firestore:', err);
      }
    }
  };

  // Delete Expense
  const deleteExpense = async (id: string) => {
    setExpenses((prev) => {
      const updated = prev.filter((item) => item.id !== id);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
      return updated;
    });

    if (user) {
      try {
        const docRef = doc(db, 'users', user.uid, 'expenses', id);
        await deleteDoc(docRef);
      } catch (err) {
        console.error('Failed to delete expense from Firestore:', err);
      }
    }
  };

  // Reset or Seed Sample Data
  const resetToSampleData = () => {
    const samples = generateSampleExpenses(user ? user.uid : 'local_guest');
    setExpenses(samples);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(samples));
    if (user) {
      syncLocalToFirestore(user.uid, samples);
    }
  };

  // Calculate Dashboard Stats
  const dashboardStats = useMemo<DashboardStats>(() => {
    const now = new Date();
    const todayStr = now.toISOString().slice(0, 10);

    // Get current week boundaries
    const dayOfWeek = now.getDay(); // 0 = Sun
    const startOfWeek = new Date(now);
    startOfWeek.setDate(now.getDate() - dayOfWeek);
    startOfWeek.setHours(0, 0, 0, 0);

    const currentYear = now.getFullYear();
    const currentMonthStr = `${currentYear}-${String(now.getMonth() + 1).padStart(2, '0')}`;

    let todayTotal = 0;
    let weeklyTotal = 0;
    let monthlyTotal = 0;
    let yearlyTotal = 0;

    const financialBreakdown = { Need: 0, Want: 0, Desire: 0, Miscellaneous: 0 };
    const functionalBreakdown: Record<FunctionalCategory, number> = {
      Food: 0,
      Transport: 0,
      Shopping: 0,
      Health: 0,
      'Personal Care': 0,
      Education: 0,
      Bills: 0,
      Household: 0,
      Entertainment: 0,
      Travel: 0,
      Miscellaneous: 0,
    };

    const dailySums: Record<string, number> = {};

    expenses.forEach((e) => {
      const amt = Number(e.amount) || 0;

      // Category breakdowns
      if (financialBreakdown[e.financialCategory] !== undefined) {
        financialBreakdown[e.financialCategory] += amt;
      } else {
        financialBreakdown.Miscellaneous += amt;
      }

      if (functionalBreakdown[e.functionalCategory] !== undefined) {
        functionalBreakdown[e.functionalCategory] += amt;
      } else {
        functionalBreakdown.Miscellaneous += amt;
      }

      // Today
      if (e.date === todayStr) {
        todayTotal += amt;
      }

      // Weekly
      const expDate = new Date(e.date);
      if (expDate >= startOfWeek && expDate <= now) {
        weeklyTotal += amt;
      }

      // Monthly
      if (e.date.startsWith(currentMonthStr)) {
        monthlyTotal += amt;
      }

      // Yearly
      if (e.date.startsWith(String(currentYear))) {
        yearlyTotal += amt;
      }

      // Daily tracking
      dailySums[e.date] = (dailySums[e.date] || 0) + amt;
    });

    // Highest spending day
    let highestDay = { date: 'N/A', amount: 0 };
    Object.entries(dailySums).forEach(([d, sum]) => {
      if (sum > highestDay.amount) {
        highestDay = { date: d, amount: sum };
      }
    });

    // Average daily expense in current month
    const daysInMonthSoFar = Math.max(1, now.getDate());
    const avgDailyExpense = monthlyTotal / daysInMonthSoFar;

    return {
      todayTotal,
      weeklyTotal,
      monthlyTotal,
      yearlyTotal,
      avgDailyExpense,
      highestSpendingDay: highestDay,
      financialBreakdown,
      functionalBreakdown,
      totalCount: expenses.length,
    };
  }, [expenses]);

  return {
    expenses,
    loading,
    syncStatus,
    addExpense,
    updateExpense,
    deleteExpense,
    resetToSampleData,
    dashboardStats,
  };
}
