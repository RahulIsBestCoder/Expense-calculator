import React, { useState, useMemo } from 'react';
import { 
  Search, 
  Filter, 
  Calendar, 
  Plus, 
  Edit3, 
  Trash2, 
  RotateCcw, 
  ArrowUpDown,
  FileText,
  DollarSign
} from 'lucide-react';
import { Expense, FinancialCategory, FunctionalCategory, PaymentMethod, ExpenseFilterState } from '../types';
import { FINANCIAL_CATEGORIES, FUNCTIONAL_CATEGORIES } from '../data/masterCatalog';

interface ExpensesListViewProps {
  expenses: Expense[];
  currency: string;
  onOpenAddModal: () => void;
  onEditExpense: (expense: Expense) => void;
  onDeleteExpense: (id: string) => void;
}

export const ExpensesListView: React.FC<ExpensesListViewProps> = ({
  expenses,
  currency,
  onOpenAddModal,
  onEditExpense,
  onDeleteExpense,
}) => {
  const [filters, setFilters] = useState<ExpenseFilterState>({
    search: '',
    financialCategory: 'all',
    functionalCategory: 'all',
    paymentMethod: 'all',
    startDate: '',
    endDate: '',
    minAmount: undefined,
    maxAmount: undefined,
  });

  const [sortField, setSortField] = useState<'date' | 'amount' | 'title'>('date');
  const [sortOrder, setSortOrder] = useState<'asc' | 'desc'>('desc');
  const [deleteIdConfirm, setDeleteIdConfirm] = useState<string | null>(null);

  // Reset Filters
  const handleResetFilters = () => {
    setFilters({
      search: '',
      financialCategory: 'all',
      functionalCategory: 'all',
      paymentMethod: 'all',
      startDate: '',
      endDate: '',
      minAmount: undefined,
      maxAmount: undefined,
    });
  };

  // Filter & Sort Logic
  const filteredExpenses = useMemo(() => {
    return expenses.filter((item) => {
      // Search
      if (
        filters.search.trim() &&
        !item.title.toLowerCase().includes(filters.search.toLowerCase()) &&
        !(item.note || '').toLowerCase().includes(filters.search.toLowerCase())
      ) {
        return false;
      }

      // Financial Category
      if (filters.financialCategory !== 'all' && item.financialCategory !== filters.financialCategory) {
        return false;
      }

      // Functional Category
      if (filters.functionalCategory !== 'all' && item.functionalCategory !== filters.functionalCategory) {
        return false;
      }

      // Payment Method
      if (filters.paymentMethod !== 'all' && item.paymentMethod !== filters.paymentMethod) {
        return false;
      }

      // Start Date
      if (filters.startDate && item.date < filters.startDate) {
        return false;
      }

      // End Date
      if (filters.endDate && item.date > filters.endDate) {
        return false;
      }

      // Min Amount
      if (filters.minAmount !== undefined && !isNaN(filters.minAmount) && item.amount < filters.minAmount) {
        return false;
      }

      // Max Amount
      if (filters.maxAmount !== undefined && !isNaN(filters.maxAmount) && item.amount > filters.maxAmount) {
        return false;
      }

      return true;
    }).sort((a, b) => {
      let comparison = 0;
      if (sortField === 'date') {
        comparison = a.date.localeCompare(b.date);
      } else if (sortField === 'amount') {
        comparison = a.amount - b.amount;
      } else if (sortField === 'title') {
        comparison = a.title.localeCompare(b.title);
      }
      return sortOrder === 'desc' ? -comparison : comparison;
    });
  }, [expenses, filters, sortField, sortOrder]);

  const filteredTotal = filteredExpenses.reduce((sum, item) => sum + item.amount, 0);

  return (
    <div className="space-y-6 pb-12">
      
      {/* Top Header & Quick Action */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg">
        <div>
          <h2 className="text-xl font-bold text-white">Expenses Log & Search</h2>
          <p className="text-xs text-slate-400">Filter, edit, and audit your expense items</p>
        </div>
        <div className="flex items-center space-x-3">
          <button
            onClick={onOpenAddModal}
            className="flex items-center space-x-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold px-4 py-2 rounded-xl text-xs transition-all shadow-md active:scale-95"
          >
            <Plus className="w-4 h-4" />
            <span>Record Expense</span>
          </button>
        </div>
      </div>

      {/* Search & Filter Controls Panel */}
      <div className="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4">
        <div className="flex items-center justify-between">
          <span className="text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center space-x-1.5">
            <Filter className="w-3.5 h-3.5 text-emerald-400" />
            <span>Search & Filter Engine</span>
          </span>
          <button
            onClick={handleResetFilters}
            className="flex items-center space-x-1 text-xs text-slate-400 hover:text-emerald-400 transition-colors"
          >
            <RotateCcw className="w-3 h-3" />
            <span>Reset Filters</span>
          </button>
        </div>

        {/* Filter Input Grid */}
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          
          {/* Expense Name Search */}
          <div className="relative">
            <Search className="w-4 h-4 text-slate-400 absolute left-3 top-2.5" />
            <input
              type="text"
              value={filters.search}
              onChange={(e) => setFilters((prev) => ({ ...prev, search: e.target.value }))}
              placeholder="Search title or notes..."
              className="w-full bg-slate-800 border border-slate-700 text-white rounded-xl pl-9 pr-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500"
            />
          </div>

          {/* Financial Category */}
          <div>
            <select
              value={filters.financialCategory}
              onChange={(e) => setFilters((prev) => ({ ...prev, financialCategory: e.target.value }))}
              className="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500"
            >
              <option value="all">All Financial Categories</option>
              {FINANCIAL_CATEGORIES.map((fc) => (
                <option key={fc} value={fc}>
                  {fc}
                </option>
              ))}
            </select>
          </div>

          {/* Functional Category */}
          <div>
            <select
              value={filters.functionalCategory}
              onChange={(e) => setFilters((prev) => ({ ...prev, functionalCategory: e.target.value }))}
              className="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500"
            >
              <option value="all">All Functional Categories</option>
              {FUNCTIONAL_CATEGORIES.map((cat) => (
                <option key={cat} value={cat}>
                  {cat}
                </option>
              ))}
            </select>
          </div>

          {/* Payment Method */}
          <div>
            <select
              value={filters.paymentMethod}
              onChange={(e) => setFilters((prev) => ({ ...prev, paymentMethod: e.target.value }))}
              className="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500"
            >
              <option value="all">All Payment Methods</option>
              <option value="Cash">Cash</option>
              <option value="Credit Card">Credit Card</option>
              <option value="Debit Card">Debit Card</option>
              <option value="Bank Transfer">Bank Transfer</option>
              <option value="Digital Wallet">Digital Wallet</option>
              <option value="Other">Other</option>
            </select>
          </div>

          {/* Date Range Start */}
          <div className="flex items-center space-x-2">
            <span className="text-xs text-slate-400 font-medium whitespace-nowrap">From:</span>
            <input
              type="date"
              value={filters.startDate}
              onChange={(e) => setFilters((prev) => ({ ...prev, startDate: e.target.value }))}
              className="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500"
            />
          </div>

          {/* Date Range End */}
          <div className="flex items-center space-x-2">
            <span className="text-xs text-slate-400 font-medium whitespace-nowrap">To:</span>
            <input
              type="date"
              value={filters.endDate}
              onChange={(e) => setFilters((prev) => ({ ...prev, endDate: e.target.value }))}
              className="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500"
            />
          </div>

          {/* Min Amount */}
          <div>
            <input
              type="number"
              placeholder={`Min ${currency}`}
              value={filters.minAmount !== undefined ? filters.minAmount : ''}
              onChange={(e) =>
                setFilters((prev) => ({
                  ...prev,
                  minAmount: e.target.value ? parseFloat(e.target.value) : undefined,
                }))
              }
              className="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500"
            />
          </div>

          {/* Max Amount */}
          <div>
            <input
              type="number"
              placeholder={`Max ${currency}`}
              value={filters.maxAmount !== undefined ? filters.maxAmount : ''}
              onChange={(e) =>
                setFilters((prev) => ({
                  ...prev,
                  maxAmount: e.target.value ? parseFloat(e.target.value) : undefined,
                }))
              }
              className="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500"
            />
          </div>

        </div>
      </div>

      {/* Filter Stats Bar */}
      <div className="flex items-center justify-between text-xs text-slate-400 bg-slate-900/50 px-4 py-2.5 rounded-xl border border-slate-800">
        <div>
          Showing <strong className="text-white">{filteredExpenses.length}</strong> of{' '}
          <strong className="text-white">{expenses.length}</strong> total records
        </div>
        <div className="text-right">
          Filtered Sum: <strong className="text-emerald-400 text-sm font-bold">{currency}{filteredTotal.toFixed(2)}</strong>
        </div>
      </div>

      {/* Expenses Table */}
      <div className="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-lg">
        <div className="overflow-x-auto">
          <table className="w-full text-left text-xs">
            <thead className="bg-slate-800/80 text-slate-300 font-semibold uppercase border-b border-slate-700/80">
              <tr>
                <th
                  onClick={() => {
                    setSortField('date');
                    setSortOrder(sortOrder === 'asc' ? 'desc' : 'asc');
                  }}
                  className="py-3.5 pl-4 pr-2 cursor-pointer hover:text-white"
                >
                  <div className="flex items-center space-x-1">
                    <span>Date</span>
                    <ArrowUpDown className="w-3 h-3" />
                  </div>
                </th>
                <th
                  onClick={() => {
                    setSortField('title');
                    setSortOrder(sortOrder === 'asc' ? 'desc' : 'asc');
                  }}
                  className="py-3.5 px-3 cursor-pointer hover:text-white"
                >
                  <div className="flex items-center space-x-1">
                    <span>Expense Name</span>
                    <ArrowUpDown className="w-3 h-3" />
                  </div>
                </th>
                <th className="py-3.5 px-3">Financial Category</th>
                <th className="py-3.5 px-3">Functional Category</th>
                <th className="py-3.5 px-3">Payment Method</th>
                <th className="py-3.5 px-3">Notes</th>
                <th
                  onClick={() => {
                    setSortField('amount');
                    setSortOrder(sortOrder === 'asc' ? 'desc' : 'asc');
                  }}
                  className="py-3.5 px-3 text-right cursor-pointer hover:text-white"
                >
                  <div className="flex items-center justify-end space-x-1">
                    <span>Amount</span>
                    <ArrowUpDown className="w-3 h-3" />
                  </div>
                </th>
                <th className="py-3.5 pr-4 text-center">Actions</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-800">
              {filteredExpenses.length > 0 ? (
                filteredExpenses.map((e) => (
                  <tr key={e.id} className="hover:bg-slate-800/50 transition-colors group">
                    <td className="py-3.5 pl-4 pr-2 text-slate-400 font-mono">{e.date}</td>
                    <td className="py-3.5 px-3 font-bold text-white text-sm">{e.title}</td>
                    <td className="py-3.5 px-3">
                      <span
                        className={`px-2.5 py-1 rounded-md font-semibold text-[10px] border ${
                          e.financialCategory === 'Need'
                            ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30'
                            : e.financialCategory === 'Want'
                            ? 'bg-blue-500/10 text-blue-400 border-blue-500/30'
                            : e.financialCategory === 'Desire'
                            ? 'bg-purple-500/10 text-purple-400 border-purple-500/30'
                            : 'bg-slate-800 text-slate-400 border-slate-700'
                        }`}
                      >
                        {e.financialCategory}
                      </span>
                    </td>
                    <td className="py-3.5 px-3 text-slate-300 font-medium">{e.functionalCategory}</td>
                    <td className="py-3.5 px-3 text-slate-400">{e.paymentMethod}</td>
                    <td className="py-3.5 px-3 text-slate-400 max-w-xs truncate" title={e.note}>
                      {e.note || '-'}
                    </td>
                    <td className="py-3.5 px-3 text-right font-extrabold text-white text-sm">
                      {currency}{e.amount.toFixed(2)}
                    </td>
                    <td className="py-3.5 pr-4 text-center">
                      <div className="flex items-center justify-center space-x-1">
                        <button
                          onClick={() => onEditExpense(e)}
                          className="p-1.5 text-slate-400 hover:text-emerald-400 rounded-lg hover:bg-slate-800 transition-colors"
                          title="Edit Expense"
                        >
                          <Edit3 className="w-4 h-4" />
                        </button>
                        
                        {deleteIdConfirm === e.id ? (
                          <div className="flex items-center space-x-1">
                            <button
                              onClick={() => {
                                onDeleteExpense(e.id);
                                setDeleteIdConfirm(null);
                              }}
                              className="px-2 py-0.5 bg-rose-500 hover:bg-rose-400 text-white rounded text-[10px] font-bold"
                            >
                              Confirm
                            </button>
                            <button
                              onClick={() => setDeleteIdConfirm(null)}
                              className="px-2 py-0.5 bg-slate-700 text-slate-300 rounded text-[10px]"
                            >
                              Cancel
                            </button>
                          </div>
                        ) : (
                          <button
                            onClick={() => setDeleteIdConfirm(e.id)}
                            className="p-1.5 text-slate-400 hover:text-rose-400 rounded-lg hover:bg-slate-800 transition-colors"
                            title="Delete Expense"
                          >
                            <Trash2 className="w-4 h-4" />
                          </button>
                        )}
                      </div>
                    </td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colSpan={8} className="py-12 text-center text-slate-500 text-xs">
                    No expense items match the current search filters
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>

    </div>
  );
};
