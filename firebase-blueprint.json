import React, { useState } from 'react';
import { BookOpen, Search, Plus, Sparkles, Check, Edit2 } from 'lucide-react';
import { MasterExpenseItem, FinancialCategory, FunctionalCategory } from '../types';
import { FINANCIAL_CATEGORIES, FUNCTIONAL_CATEGORIES } from '../data/masterCatalog';

interface MasterCatalogViewProps {
  catalog: MasterExpenseItem[];
  saveCatalogItem: (item: MasterExpenseItem) => void;
}

export const MasterCatalogView: React.FC<MasterCatalogViewProps> = ({
  catalog,
  saveCatalogItem,
}) => {
  const [search, setSearch] = useState('');
  const [newName, setNewName] = useState('');
  const [newFinancial, setNewFinancial] = useState<FinancialCategory>('Need');
  const [newFunctional, setNewFunctional] = useState<FunctionalCategory>('Food');
  const [editingItem, setEditingItem] = useState<MasterExpenseItem | null>(null);

  const filteredCatalog = catalog.filter((item) =>
    item.name.toLowerCase().includes(search.toLowerCase()) ||
    item.financialCategory.toLowerCase().includes(search.toLowerCase()) ||
    item.functionalCategory.toLowerCase().includes(search.toLowerCase())
  );

  const handleSave = (e: React.FormEvent) => {
    e.preventDefault();
    if (!newName.trim()) return;

    saveCatalogItem({
      name: newName.trim(),
      financialCategory: newFinancial,
      functionalCategory: newFunctional,
    });

    setNewName('');
    setNewFinancial('Need');
    setNewFunctional('Food');
    setEditingItem(null);
  };

  const startEdit = (item: MasterExpenseItem) => {
    setEditingItem(item);
    setNewName(item.name);
    setNewFinancial(item.financialCategory);
    setNewFunctional(item.functionalCategory);
  };

  return (
    <div className="space-y-6 pb-12">
      
      {/* Top Banner */}
      <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-lg">
        <div className="flex items-center space-x-3 mb-2">
          <div className="p-2.5 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 rounded-xl">
            <BookOpen className="w-5 h-5" />
          </div>
          <div>
            <h2 className="text-xl font-bold text-white">Master Expense Catalog</h2>
            <p className="text-xs text-slate-400">
              Automates categorization by learning default mappings (e.g. Breakfast → Need / Food, Petrol → Need / Transport)
            </p>
          </div>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        {/* Left Form: Add / Edit Catalog Mapping */}
        <div className="lg:col-span-4 bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-lg space-y-4">
          <h3 className="text-sm font-bold text-white flex items-center space-x-2">
            <Sparkles className="w-4 h-4 text-emerald-400" />
            <span>{editingItem ? 'Edit Mapping' : 'Add Catalog Mapping'}</span>
          </h3>

          <form onSubmit={handleSave} className="space-y-4">
            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                Expense Name
              </label>
              <input
                type="text"
                value={newName}
                onChange={(e) => setNewName(e.target.value)}
                placeholder="e.g. Coffee, Hotel Stay, Gym"
                className="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3.5 py-2.5 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500"
                required
              />
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                Default Financial Category
              </label>
              <select
                value={newFinancial}
                onChange={(e) => setNewFinancial(e.target.value as FinancialCategory)}
                className="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3.5 py-2.5 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500"
              >
                {FINANCIAL_CATEGORIES.map((fc) => (
                  <option key={fc} value={fc}>
                    {fc}
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">
                Default Functional Category
              </label>
              <select
                value={newFunctional}
                onChange={(e) => setNewFunctional(e.target.value as FunctionalCategory)}
                className="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3.5 py-2.5 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500"
              >
                {FUNCTIONAL_CATEGORIES.map((cat) => (
                  <option key={cat} value={cat}>
                    {cat}
                  </option>
                ))}
              </select>
            </div>

            <div className="flex items-center space-x-2 pt-2">
              <button
                type="submit"
                className="flex-1 flex items-center justify-center space-x-1.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold py-2.5 rounded-xl text-xs transition-all shadow-md active:scale-95"
              >
                <Check className="w-4 h-4" />
                <span>{editingItem ? 'Update Mapping' : 'Save To Catalog'}</span>
              </button>
              {editingItem && (
                <button
                  type="button"
                  onClick={() => {
                    setEditingItem(null);
                    setNewName('');
                  }}
                  className="px-3 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs"
                >
                  Cancel
                </button>
              )}
            </div>
          </form>
        </div>

        {/* Right Table: Catalog Directory */}
        <div className="lg:col-span-8 bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-lg space-y-4">
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <h3 className="text-sm font-bold text-white">Catalog Mappings ({catalog.length})</h3>
            <div className="relative w-full sm:w-64">
              <Search className="w-3.5 h-3.5 text-slate-400 absolute left-3 top-2.5" />
              <input
                type="text"
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="Search catalog..."
                className="w-full bg-slate-800 border border-slate-700 text-white rounded-xl pl-8 pr-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500"
              />
            </div>
          </div>

          <div className="overflow-x-auto border border-slate-800 rounded-xl">
            <table className="w-full text-left text-xs">
              <thead className="bg-slate-800/80 text-slate-400 font-semibold uppercase border-b border-slate-700">
                <tr>
                  <th className="py-3 px-4">Expense Name</th>
                  <th className="py-3 px-3">Financial Category</th>
                  <th className="py-3 px-3">Functional Category</th>
                  <th className="py-3 px-3 text-center">Action</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-800">
                {filteredCatalog.length > 0 ? (
                  filteredCatalog.map((item, idx) => (
                    <tr key={idx} className="hover:bg-slate-800/40 transition-colors">
                      <td className="py-3 px-4 font-bold text-white">{item.name}</td>
                      <td className="py-3 px-3">
                        <span
                          className={`px-2.5 py-0.5 rounded-md font-medium text-[10px] border ${
                            item.financialCategory === 'Need'
                              ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30'
                              : item.financialCategory === 'Want'
                              ? 'bg-blue-500/10 text-blue-400 border-blue-500/30'
                              : item.financialCategory === 'Desire'
                              ? 'bg-purple-500/10 text-purple-400 border-purple-500/30'
                              : 'bg-slate-800 text-slate-400 border-slate-700'
                          }`}
                        >
                          {item.financialCategory}
                        </span>
                      </td>
                      <td className="py-3 px-3 text-slate-300">{item.functionalCategory}</td>
                      <td className="py-3 px-3 text-center">
                        <button
                          onClick={() => startEdit(item)}
                          className="p-1 text-slate-400 hover:text-emerald-400 rounded hover:bg-slate-800"
                          title="Edit mapping"
                        >
                          <Edit2 className="w-3.5 h-3.5" />
                        </button>
                      </td>
                    </tr>
                  ))
                ) : (
                  <tr>
                    <td colSpan={4} className="py-8 text-center text-slate-500 text-xs">
                      No matching catalog items found
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>

      </div>

    </div>
  );
};
